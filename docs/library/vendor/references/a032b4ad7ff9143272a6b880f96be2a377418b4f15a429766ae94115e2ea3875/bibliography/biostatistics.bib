@article{Hillary2021,
  author = {Hillary, Luke S. and Farkas, Kata and Maher, Kathryn H. and Lucaci, Anita and Thorpe, Jamie and Distaso, Marco A. and Gaze, William H. and Paterson, Steve and Burke, Terry and Connor, Thomas R. and McDonald, James E. and Malham, Shelagh K. and Jones, David L.},
  title = {Monitoring SARS-CoV-2 in municipal wastewater to evaluate the success of lockdown measures for controlling COVID-19 in the UK},
  journaltitle = {Water Research},
  volume = {200},
  publisher = {Elsevier BV},
  date = {2021-07},
  pages = {117214},
  doi = {10.1016/j.watres.2021.117214},
  url = {https://doi.org/10.1016/j.watres.2021.117214},
  issn = {0043-1354},
  keywords = {Municipal wastewater ; SARS-CoV-2 ; Communicable Disease Control ; Coronavirus outbreak ; COVID-19 ; COVID-19 infection ; disease control ; disease transmission ; economic development ; health policy ; human health ; Humans ; Infection control ; longitudinal studies ; monitoring ; Pandemics ; Public health ; RNA ; RNA Viral ; sequence analysis ; Severe acute respiratory syndrome coronavirus 2 ; sewage ; Sewage surveillance ; United Kingdom ; viral genome ; viruses ; Wastewater ; water},
  abstract = {Wastewater was used to monitor SARS-CoV-2 prevalence and genetic diversity. SARS-CoV-2 RNA abundance and diversity reflects clinical case load and lineages. Temporal analysis of SARS-CoV-2 in sewage tracks the effectiveness of lockdowns. Wastewater-based epidemiology is a useful tool for pandemic response policy. Further research is required to understand factors that affect virus quantification. SARS-CoV-2 and the resulting COVID-19 pandemic represents one of the greatest recent threats to human health, wellbeing and economic growth. Wastewater-based epidemiology (WBE) of human viruses can be a useful tool for population-scale monitoring of SARS-CoV-2 prevalence and epidemiology to help prevent further spread of the disease, particularly within urban centres. Here, we present a longitudinal analysis (March--July 2020) of SARS-CoV-2 RNA prevalence in sewage across six major urban centres in the UK (total population equivalent 3 million) by q(RT-)PCR and viral genome sequencing. Our results demonstrate that levels of SARS-CoV-2 RNA generally correlated with the abundance of clinical cases recorded within the community in large urban centres, with a marked decline in SARS-CoV-2 RNA abundance following the implementation of lockdown measures. The strength of this association was weaker in areas with lower confirmed COVID-19 case numbers. Further, sequence analysis of SARS-CoV-2 from wastewater suggested that multiple genetically distinct clusters were co-circulating in the local populations covered by our sample sites, and that the genetic variants observed in wastewater reflected similar SNPs observed in contemporaneous samples from cases tested in clinical diagnostic laboratories. We demonstrate how WBE can be used for both community-level detection and tracking of SARS-CoV-2 and other human pathogenic viruses circulating in the population and assessment of the effectiveness of disease control measures. Although, greater understanding of the factors that affect SARS-CoV-2 RNA concentration in wastewater are needed for the full integration of WBE data into outbreak surveillance. In conclusion, our results lend support to the use of routine WBE for monitoring of SARS-CoV-2 and other human pathogenic viruses circulating in the population and assessment of the effectiveness of disease control measures.},
  language = {eng},
  usera = {filename=Hillary2021_monitoring_sars_municipal_wastewater_evaluate_success_lockdown_measures.pdf},
  userb = {supplemental=Hillary2021_supplemental.docx},
  copyright = {2021 Elsevier Ltd},
}

