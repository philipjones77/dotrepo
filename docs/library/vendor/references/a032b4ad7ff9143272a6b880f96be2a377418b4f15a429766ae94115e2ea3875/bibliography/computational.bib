@article{Li2023,
  author = {Li, Xiao Peng and Yan, Yi and Kuruoglu, Ercan Engin and So, Hing Cheung and Chen, Yuan},
  title = {Robust Recovery for Graph Signal via $\ell_0$-Norm Regularization},
  journaltitle = {IEEE Signal Processing Letters},
  volume = {30},
  publisher = {Institute of Electrical and Electronics Engineers (IEEE)},
  date = {2023},
  pages = {1322--1326},
  doi = {10.1109/LSP.2023.3316095},
  url = {https://doi.org/10.1109/LSP.2023.3316095},
  keywords = {graph signal processing, numerical algorithm},
  abstract = {Graph signal processing refers to dealing with irregularly structured data. Compared with traditional signal processing, it can preserve the complex interactions within irregular data. In this work, we devise a robust algorithm to recover band-limited graph signals in the presence of impulsive noise. First, the observed data vector is recast, such that the noise component is divided into two vectors, representing the dense-noise component and sparse outliers, respectively. We then exploit $\ell_0$ -norm to characterize the sparse vector as a regularization term. Alternating minimization is subsequently adopted as the solver for the resultant optimization problem. Besides, we suggest an approach to automatically update the penalty parameter of the $\ell_0$ -norm term. In addition, we analyze the computational complexity and the steady-state convergence of our algorithm. Experimental results on synthetic and temperature data exhibit the superiority of the developed method over stateof-the-art algorithms in impulsive noise environments in terms of recovery accuracy and convergence speed.},
  usera = {filename=Li2023_robust_recovery_graph_signal_norm_regularization.pdf},
}

