}

@report{Zulfiqar2026,
  author = {Zulfiqar, Umair},
  title = {{$LDL^\top$} Factorization-Based Generalized Low-Rank {ADI} Algorithm for Solving Large-Scale Algebraic {Riccati} Equations},
  journaltitle = {arXiv},
  date = {2026-04-08},
  doi = {10.48550/arXiv.2604.06556},
  url = {https://arxiv.org/abs/2604.06556},
  eprint = {2604.06556},
  eprinttype = {arxiv},
  eprintclass = {math.NA},
  keywords = {math.NA, cs.NA, eess.SY, algebraic Riccati equations, low-rank ADI},
  abstract = {The low-rank alternating direction implicit method is an efficient solver for large-scale standard continuous-time algebraic Riccati equations that admit low-rank solutions, but existing RADI algorithms cannot be directly applied to general-form Riccati equations. This paper introduces a generalized RADI algorithm based on an \(LDL^\top\) factorization, gives an implementation that avoids the Sherman--Morrison--Woodbury formula, discusses automatic ADI shift generation, and reports numerical examples for Riccati equations of orders from \(10^6\) to \(10^7\).},
  note = {Associated G-RADI MATLAB code archived at Zenodo, doi:10.5281/zenodo.19568180},
  usera = {filename=Zulfiqar2026_ldl_factorization_based_generalized_low_rank_adi_algorithm.pdf},
  userb = {software=Zulfiqar2026_software},
}
