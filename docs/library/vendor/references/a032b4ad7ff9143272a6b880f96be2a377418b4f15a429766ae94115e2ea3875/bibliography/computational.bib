@article{Lemeunier2023,
  author = {Lemeunier, Clément and Denis, Florence and Lavoué, Guillaume and Dupont, Florent},
  title = {{SpecTrHuMS}: Spectral transformer for human mesh sequence learning},
  journaltitle = {Computers \& Graphics},
  volume = {115},
  publisher = {Elsevier},
  date = {2023},
  pages = {191--203},
  doi = {10.1016/j.cag.2023.07.001},
  url = {https://doi.org/10.1016/j.cag.2023.07.001},
  issn = {0097-8493},
  keywords = {human body triangular mesh sequences, autoencoder, computer graphics, computer vision, geometric deep learning, machine learning, spectral analysis, transformers, graph Laplacian},
  abstract = {The paper presents SpecTrHuMS, a spectral transformer for learning 3D triangular human mesh sequences. The method combines deep learning with spectral mesh processing by projecting the vertices of each mesh frame onto graph-Laplacian eigenvectors from a common triangulation, encoding the resulting spectral coefficients with a convolutional encoder, modeling temporal dependencies with a transformer, and decoding back to spectral coefficients before reconstructing the spatial mesh sequence. Experiments on AMASS show that the model can predict realistic movements while preserving subject identity, and additional experiments demonstrate extensions to long-term prediction and completion for datasets with constant mesh connectivity.},
  language = {eng},
  usera = {filename=Lemeunier2023_spectrhums_spectral_transformer_human_mesh_sequence_learning.pdf},
  userb = {software=Lemeunier2023_software},
  userc = {software=github/MEPP-team/SpecTrHuMS},
  userd = {supplemental=Lemeunier2023_supplemental.mp4},
}

