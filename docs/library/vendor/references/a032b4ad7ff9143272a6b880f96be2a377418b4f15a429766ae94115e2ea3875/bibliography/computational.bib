@article{Xia2010,
  author = {Xia, Jianlin and Chandrasekaran, Shivkumar and Gu, Ming and Li, Xiaoye S.},
  title = {Fast algorithms for hierarchically semiseparable matrices},
  journaltitle = {Numerical Linear Algebra with Applications},
  volume = {17},
  number = {6},
  date = {2010},
  pages = {953--976},
  doi = {10.1002/nla.691},
  url = {https://doi.org/10.1002/nla.691},
  issn = {1070-5325},
  keywords = {HSS matrix, postordering HSS tree, low-rank property, fast HSS algorithms, generalized HSS Cholesky factorization, numerical linear algebra},
  abstract = {Semiseparable matrices and many other rank-structured matrices have been widely used in developing new fast matrix algorithms. In this paper, the authors generalize hierarchically semiseparable (HSS) matrix representations and propose fast algorithms for HSS matrices. They represent HSS matrices using general binary HSS trees with simplified postordering notation, develop fast HSS structure generation and HSS-form Cholesky factorization algorithms, and give a linear-complexity explicit ULV factorization algorithm for symmetric positive definite HSS matrices with a low-rank property. The corresponding factors solve HSS systems in linear complexity, and numerical examples demonstrate the efficiency and data locality of the algorithms for applications including discretized PDEs, integral equations, and eigenvalue problems.},
  language = {eng},
  usera = {filename=Xia2010_fast_algorithms_hierarchically_semiseparable_matrices.pdf},
  copyright = {Copyright © 2009 John Wiley \& Sons, Ltd.},
  verbb = {issn-alternates=1099-1506},
}

@report{Xing2020a,
  author = {Xin Xing and Hua Huang and Edmond Chow},
  title = {Efficient construction of an HSS preconditioner for symmetric positive definite $\mathcal{H}^2$ matrices},
  journaltitle = {arXiv},
  date = {2020-11-15},
  doi = {10.48550/arXiv.2011.07632},
  url = {https://doi.org/10.48550/arXiv.2011.07632},
  eprint = {2011.07632v2},
  eprinttype = {arxiv},
  eprintclass = {math.NA},
  keywords = {math.NA},
  abstract = {In an iterative approach for solving linear systems with ill-conditioned, symmetric positive definite (SPD) kernel matrices, both fast matrix-vector products and fast preconditioning operations are required. Fast (linear-scaling) matrix-vector products are available by expressing the kernel matrix in an $\mathcal{H}^2$ representation or an equivalent fast multipole method representation. Preconditioning such matrices, however, requires a structured matrix approximation that is more regular than the $\mathcal{H}^2$ representation, such as the hierarchically semiseparable (HSS) matrix representation, which provides fast solve operations. Previously, an algorithm was presented to construct an HSS approximation to an SPD kernel matrix that is guaranteed to be SPD. However, this algorithm has quadratic cost and was only designed for recursive binary partitionings of the points defining the kernel matrix. This paper presents a general algorithm for constructing an SPD HSS approximation. Importantly, the algorithm uses the $\mathcal{H}^2$ representation of the SPD matrix to reduce its computational complexity from quadratic to quasilinear. Numerical experiments illustrate how this SPD HSS approximation performs as a preconditioner for solving linear systems arising from a range of kernel functions.},
  usera = {filename=Arxiv2011_arxiv_2011_07632v2_math_2021.pdf},
  userb = {filename=Arxiv2011_efficient_construction_preconditioner_symmetric_positive_definite_mathcal_matrices.pdf},
}

