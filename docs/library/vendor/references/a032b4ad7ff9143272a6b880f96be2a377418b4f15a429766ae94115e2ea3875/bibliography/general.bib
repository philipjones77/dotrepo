@article{Berthou2024,
  author = {Berthou, Ségolène and Renshaw, Richard and Smyth, Tim and Tinker, Jonathan and Grist, Jeremy P. and Wihsgott, Juliane Uta and Jones, Sam and Inall, Mark and Nolan, Glenn and Berx, Barbara and Arnold, Alex and Blunn, Lewis P. and Castillo, Juan Manuel and Cotterill, Daniel and Daly, Eoghan and Dow, Gareth and Gómez, Breogán and Fraser-Leonhardt, Vivian and Hirschi, Joel J.-M. and Lewis, Huw W. and Mahmood, Sana and Worsfold, Mark},
  title = {Exceptional atmospheric conditions in June 2023 generated a northwest European marine heatwave which contributed to breaking land temperature records},
  journaltitle = {Communications Earth \& Environment},
  volume = {5},
  number = {1},
  date = {2024-05-30},
  pages = {287},
  doi = {10.1038/s43247-024-01413-8},
  url = {https://doi.org/10.1038/s43247-024-01413-8},
  issn = {2662-4435},
  keywords = {marine heatwaves, sea surface temperature, atmospheric forcing, Northwest European shelf, June 2023, climate change},
  abstract = {The Northwest European shelf experienced unprecedented surface temperature anomalies in June 2023 (anomalies up to 5 °C locally, north of Ireland). Here, we show the shelf average underwent its longest recorded category II marine heatwave (16 days). With state-of-the-art observation and modelling capabilities, we show the marine heatwave developed quickly due to strong atmospheric forcing (high level of sunshine, weak winds, tropical air) and weak wave activity under anticyclonic weather regimes. Once formed, this shallow marine heatwave fed back on the weather: over the sea it reduced cloud cover and over land it contributed to breaking June mean temperature records and to enhanced convective rainfall through stronger, warmer and moister sea breezes. This marine heatwave was intensified by the last 20-year warming trend in sea surface temperatures. Such sea surface temperatures are projected to become commonplace by the middle of the century under a high greenhouse gas emission scenario.},
  note = {Data and code underlying the main figures archived at Zenodo, doi:10.5281/zenodo.10892078},
  language = {eng},
  usera = {filename=Berthou2024_exceptional_atmospheric_conditions_june_2023_generated_northwest_european.pdf},
  userb = {software=Berthou2024_software},
  userc = {supplemental=berthou2024_review.pdf},
  copyright = {Crown Copyright as represented by Met Office and Scottish Government, and Tim Smyth, Jeremy P. Grist, Juliane Uta Wihsgott, Sam Jones, Mark Inall, Glenn Nolan, Eoghan Daly, Vivian Fraser-Leonhardt, Joel J.-M. Hirschi 2024. Licensed under CC BY 4.0},
  userd = {supplemental=berthou2024_supplemental.pdf},
}

@report{Bertiche2019,
