  url = {https://proceedings.mlr.press/v133/madadi21a.html},
  keywords = {3D garment reconstruction, texture prediction, CLOTH3D++, dynamics, NeurIPS2020, benchmark, computer vision},
  abstract = {Human avatars are important targets in many computer applications. Accurately tracking, capturing, reconstructing and animating the human body, face and garments in 3D are critical for human-computer interaction, gaming, special effects and virtual reality. This paper introduces CLOTH3D++, a large-scale dataset of more than 2M frames of animated garments with variable topology and type. The dataset contains RGBA video sequences paired with corresponding 3D data, emphasizing garment dynamics and realistic RGB rendering with lighting, fabric type and texture. The authors use the dataset for a NeurIPS 2020 competition with three tracks for 3D garment reconstruction from 3D garments, RGB garments, and RGB garments plus texture, and provide graph-convolutional-network baselines for each track.},
  language = {eng},
  usera = {filename=Madadi2021_learning_cloth_dynamics_3d_texture_garment_reconstruction_benchmark.pdf},
}

@article{Mao2025,
  author = {Mao, Yingchi and Zhou, Hongliang and Chen, Ling and Qi, Rongzhi and Sun, Zhende and Rong, Yi and He, Xiaoming and Chen, Mingkai and Mumtaz, Shahid and Frascolla, Valerio and Guizani, Mohsen and Rodrigues, Joel},
  title = {A Survey on Spatio-Temporal Prediction: From Transformers to Foundation Models},
  journaltitle = {ACM Computing Surveys},
  volume = {58},
  number = {4},
  publisher = {ACM},
  location = {New York, NY},
  date = {2025},
  pages = {1--36},
  doi = {10.1145/3766546},
  url = {https://doi.org/10.1145/3766546},
  issn = {0360-0300},
  keywords = {Surveys and overviews, Artificial intelligence, Computer science, Computing methodologies, Data base management systems, General and reference, Performance evaluation, Spatiotemporal data, Urban transportation},
  abstract = {Spatio-Temporal (ST) data is pervasive on the various aspects in our daily lives. By mining the ST information from the data, we are able to predict trends in numerous domains. The Transformer and one of its more recent enhancements, foundation models, have achieved a remarkable success in such ST prediction. In this article, we first survey the state of the art of Transformers-related work, then introduce the network architecture of the Transformer and summarize the improvements to adapt to the ST prediction Transformer and foundation models, including module enhancement and adjustment. Subsequently, we categorize the ST Transformer and foundation models in selected applications in some relevant domains, mainly urban transportation, climate monitoring, and motion prediction. Next, we propose an evaluation method in the ST prediction with Transformers and foundation models, list the most relevant open-source datasets, evaluation metrics and performance analysis. Finally, we discuss some future directions on the task of ST prediction with Transformer and foundation models.},
  note = {Companion repository: \url{https://github.com/cyhforlight/Spatio-Temporal-Prediction-Transformer-Review}},
  language = {english},
  usera = {filename=Mao2025_survey_spatio_temporal_prediction_from_transformers_foundation_models.pdf},
  userb = {software=github/cyhforlight/Spatio-Temporal-Prediction-Transformer-Review},
}

@report{Mcswiggen2018,
  author = {Colin McSwiggen},
  title = {The Harish-Chandra integral: An introduction with examples},
  journaltitle = {arXiv},
  date = {2018-06-28},
  doi = {10.48550/arXiv.1806.11155},
  url = {https://doi.org/10.48550/arXiv.1806.11155},
  eprint = {1806.11155v2},
  eprinttype = {arxiv},
  eprintclass = {math-ph},
  keywords = {math-ph, math.RT},
  abstract = {This expository paper introduces the theory of Harish-Chandra integrals, a family of special functions that express the integral of an exponential function over the adjoint orbits of a compact Lie group. Originally studied in the context of harmonic analysis on Lie algebras, Harish-Chandra integrals now have diverse applications in many areas of mathematics and physics. We review a number of these applications, present several different proofs of Harish-Chandra's celebrated exact formula for the integrals, and give detailed derivations of the specific integral formulae for all compact classical groups. These notes are intended for mathematicians and physicists who are familiar with the basics of Lie groups and Lie algebras but who may not be specialists in representation theory or harmonic analysis.},
  usera = {filename=Arxiv2021_arxiv_1806_11155v2_math_2021.pdf},
}

