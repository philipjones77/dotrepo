  issn = {0196-2892},
  keywords = {sea surface temperature, SST, deep learning, variational analysis, background error covariance, high resolution, MODIS, multisensor, Kuroshio, remote sensing},
  abstract = {The paper proposes a deep learning-driven variational analysis scheme for regional sea surface temperature at 0.01 degree grid resolution. A deep learning SST prediction model and background-error estimation algorithm generate real-time background fields, while a dynamic background error covariance improves mesoscale and submesoscale feature representation in high-variability regions. Validation against drifting buoy and Argo data reports RMSE below 0.41 degrees C, and spectral analysis indicates improved resolution of sea surface thermal features in the Kuroshio region.},
