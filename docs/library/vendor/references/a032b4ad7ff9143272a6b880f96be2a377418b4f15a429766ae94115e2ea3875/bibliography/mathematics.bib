@article{Zayed2022,
  author = {Zayed, Hanaa M. and Bulboacă, Teodor},
  title = {Normalized generalized {Bessel} function and its geometric properties},
  journaltitle = {Journal of Inequalities and Applications},
  volume = {2022},
  number = {1},
  publisher = {Springer International Publishing},
  location = {Cham},
  date = {2022},
  pages = {158},
  doi = {10.1186/s13660-022-02891-0},
  url = {https://doi.org/10.1186/s13660-022-02891-0},
  issn = {1029-242X},
  keywords = {Bessel functions, modified Bessel function, generalized Bessel function, convex functions, close-to-convex, starlike, univalent functions, convolution, Hadamard product, digamma function, gamma function, geometric function theory},
  abstract = {The normalization of the generalized Bessel functions $U_{\sigma,r}$ ($\sigma, r \in \mathbb{C}$) defined by $U_{\sigma,r}(z) = z + \sum_{j=1}^{\infty} \frac{(-r)^j}{4^j (1)_j (\sigma)_j} z^{j+1}$ was introduced, and some of its geometric properties have been presented previously. The main purpose of the present paper is to complete the results given in the literature by employing a new procedure. We first used an identity for the logarithmic of the gamma function as well as an inequality for the digamma function to establish sufficient conditions on the parameters so that $U_{\sigma,r}$ is starlike or convex of order $\alpha$ ($0 \le \alpha \le 1$) in the open unit disk. Moreover, the starlikeness and convexity of $U_{\sigma,r}$ have been considered where the leading concept of the proofs comes from the starlikeness of the power series $f(z) = \sum_{j=1}^{\infty} A_j z^j$ and the classical Alexander theorem between the classes of starlike and convex functions. We gave a simple proof to show that our conditions are not contradictory. Ultimately, the close-to-convexity of $(z \cos z) * U_{\sigma,r}$ and $(\sin z) * U_{\sigma,r}(z^2)/z$ have been determined, where ``$*$'' stands for the convolution between the power series.},
  language = {english},
  usera = {filename=Zayed2022_normalized_generalized_bessel_function_geometric_properties.pdf},
  copyright = {The Author(s) 2022},
}

@inproceedings{Zhang2021b,
  author = {Zhang, Sharon and Moscovich, Amit and Singer, Amit},
  editor = {Banerjee, Arindam and Fukumizu, Kenji},
  title = {Product Manifold Learning},
  journaltitle = {arXiv},
  booktitle = {Proceedings of The 24th International Conference on Artificial Intelligence and Statistics},
  series = {Proceedings of Machine Learning Research},
  volume = {130},
  publisher = {PMLR},
  date = {2021},
  pages = {3241--3249},
  doi = {10.48550/arXiv.2010.09908},
  url = {https://proceedings.mlr.press/v130/zhang21j.html},
  eprint = {2010.09908},
  eprinttype = {arxiv},
  eprintclass = {cs.LG},
  keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Learning, Statistics - Machine Learning, product manifolds, manifold learning, spectral graph methods, Laplace-Beltrami operator, independent component analysis, cryo-EM},
  abstract = {We consider problems of dimensionality reduction and learning data representations for continuous spaces with two or more independent degrees of freedom. Such problems occur, for example, when observing shapes with several components that move independently. Mathematically, if the parameter space of each continuous independent motion is a manifold, then their combination is known as a product manifold. In this paper, we present a new paradigm for non-linear independent component analysis called manifold factorization. Our factorization algorithm is based on spectral graph methods for manifold learning and the separability of the Laplacian operator on product spaces. Recovering the factors of a manifold yields meaningful lower-dimensional representations and provides a new way to focus on particular aspects of the data space while ignoring others. We demonstrate the potential use of our method for an important and challenging problem in structural biology: mapping the motions of proteins and other large molecules using cryo-electron microscopy datasets.},
  language = {english},
  usera = {filename=Zhang2021a_product_manifold_learning.pdf},
  userb = {software=Zhang2021a_software},
  copyright = {http://arxiv.org/licenses/nonexclusive-distrib/1.0},
}

