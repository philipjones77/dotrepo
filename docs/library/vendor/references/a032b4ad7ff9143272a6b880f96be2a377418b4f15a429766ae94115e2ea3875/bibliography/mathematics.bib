  eprint = {2012.15108},
  eprinttype = {arxiv},
  eprintclass = {hep-th},
  issn = {0031-9007},
  keywords = {Mellin-Barnes integrals, multiple series representations, conic hulls, hypergeometric functions, Feynman integrals, mathematical physics},
  abstract = {Mellin-Barnes (MB) integrals are well-known objects appearing in many branches of mathematics and physics, ranging from hypergeometric functions theory to quantum field theory, solid-state physics, and asymptotic theory. Although MB integrals have been studied for more than one century, there had been no systematic computational technique for multiple series representations of $N$-fold MB integrals for $N>2$. Relying on a geometrical analysis based on conic hulls, the authors give a method for resonant and nonresonant cases that can produce convergent series representations or divergent asymptotic ones. When convergent series are obtained, the method often identifies a single master series for each representation, simplifying convergence studies and numerical checks. The paper also provides a Mathematica implementation and applications including the first evaluation of hexagon and double-box conformal Feynman integrals with unit propagator powers.},
  language = {eng},
  usera = {filename=Ananthanarayan2021_multiple_series_representations_n_fold_mellin_barnes_integrals.pdf},
  copyright = {Published by the American Physical Society},
  verbb = {issn-alternates=1079-7114},
}

