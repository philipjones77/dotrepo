@article{Antoulas2025,
  author = {Antoulas, Athanasios C. and Gosea, Ion Victor and Poussot-Vassal, Charles},
  title = {The {Loewner} framework applied to {Zolotarev} sign and ratio problems},
  journaltitle = {arXiv},
  date = {2025},
  doi = {10.48550/arXiv.2511.04404},
  url = {https://arxiv.org/abs/2511.04404},
  eprint = {2511.04404},
  eprinttype = {arxiv},
  eprintclass = {math.NA},
  keywords = {Loewner framework, Zolotarev sign problem, Zolotarev ratio problem, rational approximation, AAA algorithm, AAA-Lawson, numerical analysis, math.NA, cs.NA, Computer Science - Numerical Analysis ; Mathematics - Numerical Analysis},
  abstract = {In this work, we propose a numerical study concerning the approximation of functions associated with the 3rd and 4th Zolotarev problems. We compare various methods, in particular the Loewner framework, the standard AAA algorithm, and recently-proposed extensions of AAA (namely, the sign and Lawson variants). We show that the Loewner framework is fast and reliable, and provides approximants with a high level of accuracy. When the approximants are of a higher degree, Loewner approximants are often more accurate than near-optimal ones computed with AAA-Lawson. Last but not least, the Loewner framework is a direct method for which the running time is typically lower than that of the iterative AAA-Lawson variants. Moreover, for the latter, the running time increases substantially with the degree of the approximant, whereas for the Loewner method, it remains constant. These claims are supported by an extensive numerical treatment.},
  language = {english},
  usera = {filename=Antoulas2025_loewner_framework_applied_zolotarev_sign_ratio_problems.pdf},
  userb = {software=Antoulas2025_software},
  userc = {software=github/cpoussot/zolotarev},
  copyright = {http://arxiv.org/licenses/nonexclusive-distrib/1.0},
}

