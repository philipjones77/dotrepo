@article{Banik2023,
  author = {Banik, Sumit and Friot, Samuel},
  title = {Multiple {Mellin--Barnes} integrals with straight contours},
  journaltitle = {Physical Review D},
  volume = {107},
  number = {1},
  publisher = {American Physical Society},
  date = {2023-01-17},
  pages = {016007},
  doi = {10.1103/PhysRevD.107.016007},
  url = {https://doi.org/10.1103/PhysRevD.107.016007},
  eprint = {2212.11839},
  eprinttype = {arxiv},
  eprintclass = {hep-th},
  issn = {2470-0010},
  keywords = {Mellin-Barnes integrals, straight contours, conic hull method, MBConicHulls.wl, Feynman integrals, epsilon expansion},
  abstract = {We show how the conic hull method, recently developed for the analytic and noniterative evaluation of multifold Mellin-Barnes (MB) integrals, can be extended to the case where these integrals have straight contours of integration parallel to the imaginary axes in the complex planes of the integration variables. MB integrals of this class appear, for instance, when one computes the $\epsilon$-expansion of dimensionally regularized Feynman integrals. The Mathematica package MBConicHulls.wl is upgraded to obtain multivariable series representations of multifold MB integrals with arbitrary straight contours. The paper presents this feature and applies it to the $\epsilon$-expansion of the dimensionally regularized massless one-loop pentagon integral in general kinematics and $D=4-2\epsilon$.},
  language = {eng},
  usera = {filename=Banik2023_multiple_mellin_barnes_integrals_straight_contours.pdf},
  copyright = {Published by the American Physical Society},
  verbb = {issn-alternates=2470-0029},
}

@article{Banik2024,
  author = {Banik, Sumit and Friot, Samuel},
  title = {Geometrical Methods for the Analytic Evaluation of Multiple {Mellin}--{Barnes} Integrals},
  journaltitle = {Acta Physica Polonica B Proceedings Supplement},
  volume = {17},
  number = {2},
  publisher = {Jagiellonian University},
  date = {2024},
  pages = {1},
  doi = {10.5506/aphyspolbsupp.17.2-a12},
  url = {https://arxiv.org/abs/2402.04174},
  eprint = {2402.04174},
  eprinttype = {arxiv},
  eprintclass = {hep-th},
  issn = {1899-2358},
  keywords = {Mellin-Barnes integrals, multivariate residues, conic hulls, regular triangulations, Feynman integrals, MBConicHulls.wl, geometrical methods, hep-th},
  abstract = {Two recently developed techniques of analytic evaluation of multifold Mellin-Barnes (MB) integrals are presented. Both approaches rest on the definition of geometrical objects conveniently associated with the MB integrands, which can then be used along with multivariate residues analysis to derive series representations of the MB integrals. The first method is based on introducing conic hulls and considering specific intersections of the latter, while the second one rests on point configurations and their regular triangulations. After a brief description of both methods, which have been automatized in the MBConicHulls.wl Mathematica package, we review some of their applications. In particular, we show how the conic hulls method was used to obtain the first analytic calculation of complicated Feynman integrals, such as the massless off-shell conformal hexagon and double-box. We then show that the triangulation method is even more efficient, as it allows one to compute these nontrivial objects and harder ones in a much faster way.},
  note = {Presented at the XLV International Conference of Theoretical Physics ``Matter to the Deepest'', Warsaw, Poland, 17-22 September 2023; PSI-PR-24-05, ZU-TH 05/24},
  language = {english},
  usera = {filename=Banik2024_geometrical_methods_analytic_evaluation_multiple_mellin_barnes_integrals.pdf},
}

@report{Banik2026,
  author = {Sumit Banik and Souvik Bera},
  title = {HyperPrecision: A Mathematica package for High-Precision Numerical Evaluation of Multivariate Hypergeometric Functions},
  journaltitle = {arXiv},
  date = {2026-05-28},
  doi = {10.48550/arXiv.2605.30216},
  url = {https://doi.org/10.48550/arXiv.2605.30216},
  eprint = {2605.30216v1},
  eprinttype = {arxiv},
  eprintclass = {hep-ph},
  keywords = {hep-ph, hep-th, math-ph},
  abstract = {In this paper, we present HyperPrecision, a Mathematica package for high-precision numerical evaluation of general Horn-type multivariate hypergeometric functions and their Laurent expansions in a small parameter $ε$. Such functions appear widely in physics and mathematics, with applications ranging from quantum field theory and string theory to number theory and statistics. Their high-precision numerical evaluation, however, remains challenging, since their defining series converge only in restricted domains and analytic continuation beyond these domains is, in general, non-trivial. HyperPrecision addresses this problem by automatically constructing the Pfaffian system of partial differential equations for a given hypergeometric function and restricting it to a one-dimensional contour in the space of variables connecting the starting to the target point. The resulting ordinary differential equation is then solved by the Frobenius method, with boundary conditions fixed analytically by the defining series. We illustrate the use of the package by evaluating commonly occurring multivariate hypergeometric functions, including the Appell $F_1$, $F_2$, $F_3$, and $F_4$ functions, the Horn $G$- and $H$-series, and the Lauricella $F_A$, $F_B$, $F_C$, and $F_D$ functions, as well as by considering applications to angular integrals, Feynman integrals, and cosmological and holographic correlators.},
  usera = {filename=Bera2026_hyperprecision_mathematica_package_high_precision_numerical_evaluation_multivariate.pdf},
  userb = {software=Bera2026_software},
  userc = {software=github/HyperPrecision/HyperPrecision},
}

