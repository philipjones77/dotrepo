@article{Narcowich2002,
  author = {Narcowich, Francis J. and Ward, Joseph D.},
  title = {Scattered Data Interpolation on Spheres: Error Estimates and Locally Supported Basis Functions},
  journaltitle = {SIAM Journal on Mathematical Analysis},
  volume = {33},
