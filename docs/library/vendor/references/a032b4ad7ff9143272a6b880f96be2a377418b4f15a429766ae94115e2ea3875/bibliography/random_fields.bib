  issn = {0090-5364},
  keywords = {Asymptotic methods, Asymptotic properties, Covariance, Design parameters, Domains, Estimating techniques, Estimators, Fields (mathematics), Lattice design, Parameter estimation, Random variables, Sampling designs, Simulation, Smoothness, Statistics, Upper bounds, onsistency, convergence rate, deformed lattice, fixed-domain asymptotics, Gaussian random field, Quadratic Variation, irregularly spaced data, Matérn covariance, microergodic parameter, random sampling, smoothness, 60M30, 60M40, Parameter estimation, Asymptotic methods, Asymptotic properties, Covariance, Design parameters, Domains, Estimating techniques, Estimators, Fields (mathematics), Lattice design, Random variables, Sampling designs, Simulation, Smoothness, Statistics, Upper bounds, Parameter estimation, Asymptotic methods, Asymptotic properties, Covariance, Design parameters, Domains, Estimating techniques, Estimators, Fields (mathematics), Lattice design, Random variables, Sampling designs, Simulation, Smoothness, Statistics, Upper bounds, Parameter estimation, Asymptotic methods, Asymptotic properties, Covariance, Design parameters, Domains, Estimating techniques, Estimators, Fields (mathematics), Lattice design, Random variables, Sampling designs, Simulation, Smoothness, Statistics, Upper bounds, Consistency, quadratic variation, Matern covariance},
  abstract = {A method is proposed for estimating the microergodic parameters (including the smoothness parameter) of stationary Gaussian random fields on ℝᵈ with isotropic Matérn covariance functions using irregularly spaced data. This approach uses higher-order quadratic variations and is applied to three designs, namely stratified sampling design, randomized sampling design and deformed lattice design. Microergodic parameter estimators are constructed for each of the designs. Under mild conditions, these estimators are shown to be consistent with respect to fixed-domain asymptotics. Upper bounds to the convergence rate of the estimators are also established. A simulation study is conducted to gauge the accuracy of the proposed estimators.},
  language = {eng},
  usera = {filename=Loh2021_fixed_domain_asymptotics_parameter_estimation_isotropic_gaussian_random.pdf},
  userb = {supplemental=Loh2021_supplemental.pdf},
