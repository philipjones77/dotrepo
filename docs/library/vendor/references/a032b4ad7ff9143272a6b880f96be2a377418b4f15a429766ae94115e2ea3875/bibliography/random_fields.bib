@incollection{Ferreira2025,
  author = {Ferreira, Marco A. R. and Ferreira, Marco A. R},
  title = {Objective Priors for Spatio-Temporal Models},
  journaltitle = {SSRN},
  booktitle = {Modeling Spatio-Temporal Data},
  volume = {1},
  edition = {1},
  publisher = {CRC Press},
  location = {United Kingdom},
  date = {2025},
  pages = {48--68},
  doi = {10.2139/ssrn.5387659},
  url = {https://doi.org/10.2139/ssrn.5387659},
  isbn = {1032622091},
  abstract = {One important aspect in the practical implementation of spatio-temporal models is the choice of priors for the hyperparameters. Because many spatio-temporal models are built as highly structured multivariate state-space models, results for state-space models may inform us about appropriate priors for large classes of spatio-temporal models. Unfortunately, the literature on objective priors for state-space models is sparse. Chapter 3 starts by reviewing this literature. We then explore the relationship between state-space models and hierarchical models with ICAR random effects to motivate the specification of objective approximate reference priors for spatio-temporal models. We use these ideas to develop an objective approximate reference prior for a class of spatio-temporal models that includes a time-varying overall mean level and dynamic spatio-temporal random effects. Of importance, the spatio-temporal random effects evolve through time with a singular evolution equation such that at each time point, the spatio-temporal random effects satisfy a sum-zero constraint. Further, we develop an efficient Markov chain Monte Carlo algorithm to explore the posterior distribution of the unknown quantities of the model. Finally, applications to simulated data and to an unemployment dataset illustrate the usefulness of our spatio-temporal framework.},
  language = {eng},
  usera = {filename=Ferreira2025a_objective_priors_spatio_temporal_models.pdf},
  copyright = {2025 selection and editorial matter, Marco A.R. Ferreira; individual chapters, the contributors},
}

@inproceedings{Ferrero2019,
  author = {Ferrero, Alessandro and Salicone, Simona and Jetti, Harsha Vardhana},
  editor = {Array},
  title = {Bayesian approach to uncertainty evaluation: is it always working?},
  journaltitle = {19th International Congress of Metrology (CIM2019)},
  booktitle = {International Congress of Metrology},
  date = {2019},
  pages = {16002},
  doi = {10.1051/metrology/201916002},
  url = {https://doi.org/10.1051/metrology/201916002},
  abstract = {Since the GUM has been published, measurement uncertainty has been defined in terms of the standard deviation of the probability distribution of the values that can be reasonably attributed to the measurand, and it has been evaluated using statistical or probabilistic methods. A debate has always been alive, among the metrologists, on whether a frequentist approach or a Bayesian approach should be followed to evaluate uncertainty. The Bayesian approach, based on some available a-priori knowledge about the measurand seems to prevail, nowadays. This paper starts from the consideration that the Bayesian approach is based on the well-known Bayes theorem that, as all mathematical theorems, is valid only to the extent the assumptions made to prove it are valid. The main question, when following the Bayesian approach, is hence whether these assumptions are satisfied in the practical cases, especially when the a-priori information is combined with the information coming from the measurement data to refine uncertainty evaluation. This paper will take into account some case studies to analyze when the Bayesian approach can be usefully and reliably employed by discussing the amount and pertinence of the available a-priori knowledge.},
  usera = {{filename=library_audit_20260704\Ferrero2019_bayesian_approach_to_uncertainty_evaluation_is_it_always_working.pdf}},
}

