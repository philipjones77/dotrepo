@article{Ma2021,
  author = {Ma, Pulong and Bhadra, Anindya},
  title = {Beyond Matérn: On A Class of Interpretable Confluent Hypergeometric Covariance Functions},
  journaltitle = {Journal of the American Statistical Association},
  volume = {118},
  number = {543},
  publisher = {Taylor \textbackslash{}\& Francis},
  location = {PHILADELPHIA},
  date = {2021},
  pages = {2045--2058},
  doi = {10.1080/01621459.2022.2027775},
  url = {https://arxiv.org/abs/1911.05865},
  eprint = {1911.05865},
  eprinttype = {arxiv},
  eprintclass = {math.ST},
  issn = {0162-1459},
  keywords = {Asymptotic methods, Asymptotic properties, Covariance, Equivalent measures, Gaussian process, Gaussian scale mixture, Infill, Mathematics, Maximum likelihood estimators, Measurement, Physical Sciences, Polynomial covariance, Polynomials, Random processes, Representations, Satellite observation, Science \textbackslash{}\& Technology, Statistics, Statistics \textbackslash{}\& Probability, Uncertainty, XCO, math.ST, stat.ME, stat.ML},
  abstract = {The Matérn covariance function is a popular choice for prediction in spatial statistics and uncertainty quantification literature. A key benefit of the Matérn class is that it is possible to get precise control over the degree of mean-square differentiability of the random process. However, the Matérn class possesses exponentially decaying tails, and thus may not be suitable for modeling polynomially decaying dependence. This problem can be remedied using polynomial covariances; however one loses control over the degree of mean-square differentiability of corresponding processes, in that random processes with existing polynomial covariances are either infinitely mean-square differentiable or nowhere mean-square differentiable at all. We construct a new family of covariance functions called the \textbackslash{}emph\textbackslash{}\textbackslash{}\textbackslash{}\{Confluent Hypergeometric\textbackslash{}\textbackslash{}\textbackslash{}\} (CH) class using a scale mixture representation of the Matérn class where one obtains the benefits of both Matérn and polynomial covariances. The resultant covariance contains two parameters: one controls the degree of mean-square differentiability near the origin and the other controls the tail heaviness, independently of each other. Using a spectral representation, we derive theoretical properties of this new covariance including equivalent measures and asymptotic behavior of the maximum likelihood estimators under infill asymptotics. The improved theoretical properties of the CH class are verified via extensive simulations. Application using NASA's Orbiting Carbon Observatory-2 satellite data confirms the advantage of the CH class over the Matérn class, especially in extrapolative settings.},
  language = {eng},
  usera = {filename=Ma2021_beyond_class_interpretable_confluent_hypergeometric_covariance_functions.pdf},
  userb = {supplemental=Ma2021_supplemental.pdf},
  userc = {software=Ma2021_software},
  archiveprefix = {arXiv},
  primaryclass = {math.ST},
}

@article{MacNab2023,
  author = {MacNab, Ying C.},
  title = {Adaptive {Gaussian Markov} random field spatiotemporal models for infectious disease mapping and forecasting},
  journaltitle = {Spatial Statistics},
  volume = {53},
  publisher = {Elsevier},
  date = {2023-03},
  pages = {100726},
  doi = {10.1016/j.spasta.2023.100726},
  url = {https://doi.org/10.1016/j.spasta.2023.100726},
  urldate = {2026-08-22},
  issn = {2211-6753},
  keywords = {adaptive Gaussian Markov random fields, conditional autoregressive models, spatiotemporal models, disease mapping, Bayesian forecasting, COVID-19},
  abstract = {Recent disease-mapping literature presents adaptively parameterized spatiotemporal autoregressive or conditional autoregressive models for Bayesian prediction of infection risks. This paper synthesizes, generalizes, and unifies these constructions through adaptive Gaussian Markov random fields, emphasizing disease forecasting. It presents a general convolution construction whose parameterizations characterize local risk dependence, heterogeneity, and discontinuity over space and time and support Poisson, zero-inflated Poisson, and Bernoulli data models. Applications to areal-level COVID-19 occurrence and zero-infection probabilities illustrate prediction and forecasting, while the framework applies more broadly to complex spatiotemporal data.},
  language = {eng},
  usera = {filename=MacNab2023_adaptive_gaussian_markov_random_field_spatiotemporal_models_infectious_disease_mapping_forecasting.pdf},
