  pages = {1--46},
  doi = {10.48550/arXiv.2004.02653},
  url = {http://jmlr.org/papers/v23/20-322.html},
  eprint = {2004.02653},
  eprinttype = {arxiv},
  eprintclass = {cs.LG},
  issn = {1532-4435},
  keywords = {Gaussian process boosting, non-linear mixed effects models, mixed effects machine learning, grouped random effects, longitudinal data, spatial data, spatio-temporal data, tree boosting, high-cardinality categorical variables, Vecchia approximation},
  abstract = {This paper introduces Gaussian process boosting, combining boosting with Gaussian process and mixed-effects models. The approach relaxes the usual zero or linear prior-mean assumption in Gaussian process and grouped random-effects models through a flexible nonparametric predictor, and also relaxes the independence assumption common in boosting algorithms. The method improves prediction accuracy, supports probabilistic prediction, handles high-cardinality categorical variables in tree boosting, and includes a Vecchia-approximation extension for scaling Gaussian process models to large data.},
