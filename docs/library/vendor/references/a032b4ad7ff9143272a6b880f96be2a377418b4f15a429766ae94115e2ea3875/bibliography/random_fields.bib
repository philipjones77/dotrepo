@article{Stein2005b,
  author = {Stein, Michael L.},
  title = {Space-Time Covariance Functions},
  journaltitle = {Journal of the American Statistical Association},
  volume = {100},
  number = {469},
  publisher = {Taylor \textbackslash{}\& Francis},
  location = {PHILADELPHIA},
  date = {2005},
  pages = {310--321},
  doi = {10.1198/016214504000000854},
  url = {https://doi.org/10.1198/016214504000000854},
  issn = {0162-1459},
  keywords = {Covariance ; Exact sciences and technology ; Fourier transformations ; Functions ; Inference from stochastic processes; time series analysis ; Integers ; Markov analysis ; Markov process ; Markov processes ; Mathematical functions ; Mathematics ; Matérn model ; Modeling ; Normal distribution ; Physical Sciences ; Probability and statistics ; Random processes on the sphere ; Science \textbackslash{}\& Technology ; Sciences and techniques of general use ; Spacetime ; Spatial isotropy ; Spatial models ; Spectral density ; Spectral energy distribution ; Statistics ; Statistics \textbackslash{}\& Probability ; Stochastic models ; Theory and Methods ; Wind velocity},
  abstract = {This work considers a number of properties of space–time covariance functions and how these relate to the spatial-temporal interactions of the process. First, it examines how the smoothness away from the origin of a space–time covariance function affects, for example, temporal correlations of spatial differences. Models that are not smoother away from the origin than they are at the origin, such as separable models, have a kind of discontinuity to certain correlations that one might wish to avoid in some circumstances. Smoothness away from the origin of a covariance function is shown to follow from the corresponding spectral density having derivatives with finite moments. These results are used to obtain a parametric class of spectral densities whose corresponding space–time covariance functions are infinitely differentiable away from the origin and that allows for essentially arbitrary and possibly different degrees of smoothness for the process in space and time. Second, this work considers models that are asymmetric in space–time; the covariance between site x at time t and site y at time s is different than the covariance between site x at time s and site y at time t. A general approach is described for generating asymmetric models from symmetric models by taking derivatives. Finally, the implications of a Markov assumption in time on space–time covariance functions for Gaussian processes are examined, and an explicit characterization of all such continuous covariance functions is given. Several of the new models described in this work are applied to wind data from Ireland.},
  language = {eng},
  usera = {filename=Stein2005a_space_time_covariance_functions.pdf},
}

@article{Stein2005c,
  author = {Stein, Michael L.},
  title = {Statistical Methods for Regular Monitoring Data},
  journaltitle = {Journal of the Royal Statistical Society Series B: Statistical Methodology},
  volume = {67},
  number = {5},
  date = {2005-11},
  pages = {667--687},
  doi = {10.1111/j.1467-9868.2005.00520.x},
  url = {https://doi.org/10.1111/j.1467-9868.2005.00520.x},
  eprint = {https://academic.oup.com/jrsssb/article-pdf/67/5/667/49795209/jrsssb\_67\_5\_667.pdf},
  issn = {1369-7412},
  abstract = {Meteorological and environmental data that are collected at regular time intervals on a fixed monitoring network can be usefully studied combining ideas from multiple time series and spatial statistics, particularly when there are little or no missing data. This work investigates methods for modelling such data and ways of approximating the associated likelihood functions. Models for processes on the sphere crossed with time are emphasized, especially models that are not fully symmetric in space–time. Two approaches to obtaining such models are described. The first is to consider a rotated version of fully symmetric models for which we have explicit expressions for the covariance function. The second is based on a representation of space–time covariance functions that is spectral in just the time domain and is shown to lead to natural partially nonparametric asymmetric models on the sphere crossed with time. Various models are applied to a data set of daily winds at 11 sites in Ireland over 18 years. Spectral and space–time domain diagnostic procedures are used to assess the quality of the fits. The spectral-in-time modelling approach is shown to yield a good fit to many properties of the data and can be applied in a routine fashion relative to finding elaborate parametric models that describe the space–time dependences of the data about as well.},
  usera = {filename=Stein2005_statistical_methods_regular_monitoring_data.pdf},
}

