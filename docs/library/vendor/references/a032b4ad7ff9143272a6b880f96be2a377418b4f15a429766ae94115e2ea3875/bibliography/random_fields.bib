@book{Kaipio2005,
  author = {Kaipio, Jari. and Somersalo, Erkki.},
  title = {Statistical and computational inverse problems},
  journaltitle = {Applied Mathematical Sciences},
  booktitle = {Statistical and computational inverse problems},
  series = {Applied mathematical sciences ; v. 160},
  edition = {1st ed. 2005.},
