  issn = {0162-8828},
  keywords = {machine learning, boosting, mixed effects models, Gaussian processes, latent Gaussian models, tree boosting, spatial data, high-cardinality categorical variables, probabilistic prediction},
  abstract = {Latent Gaussian models and boosting are widely used techniques in statistics and machine learning. Tree boosting can provide excellent prediction accuracy, but it commonly assumes conditional independence of samples, produces discontinuous predictions for spatial data, and can struggle with high-cardinality categorical variables. Latent Gaussian models, such as Gaussian process and grouped random-effects models, explicitly model dependence among samples and support efficient learning and probabilistic prediction, but often assume a zero or linear prior mean function. This article introduces a method combining boosting and latent Gaussian models to address these limitations and improve prediction accuracy in simulated and real-world experiments.},
