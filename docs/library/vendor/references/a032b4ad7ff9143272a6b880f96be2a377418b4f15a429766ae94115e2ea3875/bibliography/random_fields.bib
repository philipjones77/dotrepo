@article{Bhadra2024,
  author = {Bhadra, Anindya and Sagar, Ksheera and Rowe, David and Banerjee, Sayantan and Datta, Jyotishka},
  title = {Evidence Estimation in Gaussian Graphical Models Using a Telescoping Block Decomposition of the Precision Matrix},
  journaltitle = {Journal of Machine Learning Research},
  volume = {25},
  number = {295},
  date = {2024},
  pages = {1--43},
  doi = {10.1002/sta4.682},
  url = {https://www.jmlr.org/papers/v25/23-0254.html},
  eprint = {2205.01016},
  eprinttype = {arxiv},
  issn = {2049-1573},
  abstract = {Sparse structure learning in high‐dimensional Gaussian graphical models is an important problem in multivariate statistical inference, since the sparsity pattern naturally encodes the conditional independence relationship among variables. However, maximum a posteriori (MAP) estimation is challenging under hierarchical prior models, and traditional numerical optimization routines or expectation–maximization algorithms are difficult to implement. To this end, our contribution is a novel local linear approximation scheme that circumvents this issue using a very simple computational algorithm. Most importantly, the condition under which our algorithm is guaranteed to converge to the MAP estimate is explicitly stated and is shown to cover a broad class of completely monotone priors, including the graphical horseshoe. Further, the resulting MAP estimate is shown to be sparse and consistent in the ‐norm. Numerical results validate the speed, scalability and statistical performance of the proposed method.},
  usera = {filename=Bhadra2024_evidence_estimation_gaussian_graphical_models_using_telescoping_block.pdf},
  random_field_type = {countable},
  verbb = {issn-alternates=2049-1573},
}

