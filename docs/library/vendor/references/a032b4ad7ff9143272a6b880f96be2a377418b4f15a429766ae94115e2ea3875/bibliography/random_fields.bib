@article{Cressie2020,
  author = {Cressie, Noel and Wikle, Christopher K.},
  title = {Measuring, mapping, and uncertainty quantification in the space-time cube},
  journaltitle = {Revista Matemática Complutense},
  volume = {33},
  number = {3},
  publisher = {Springer International Publishing},
  location = {Cham},
  date = {2020},
  pages = {643--660},
  doi = {10.1007/s13163-020-00359-7},
  url = {https://doi.org/10.1007/s13163-020-00359-7},
  issn = {1139-1138},
  mrnumber = {4146554},
  mrclass = {62M30 (62P12 83A05)},
  keywords = {Algebra ; Analysis ; Applications of Mathematics ; Domains ; Geometry ; Mapping ; Mathematics ; Mathematics and Statistics ; Slicing ; Spacetime ; Statistical models ; Stochastic models ; Stochastic processes ; Topology},
  abstract = {The space-time cube is not a cube of course, but the idea of one is useful. Its base is a spatial domain, Dt , and the “cube” is traced out by a process of spatial domains, {Dt : t ≥ 0}. Now fill the cube with a spatio-temporal stochastic process {Yt (s) : s ∈ Dt , t ≥ 0}. Assume that {Dt } is fixed and known (but clearly it too could be stochastic). Slicing the cube laterally for a fixed t0 generates a spatial stochastic process {Yt0 (s) : s ∈ Dt0 }. Slicing the cube longitudinally for a fixed s0 generates a temporal process {Yt (s0 ) : t ≥ 0} that, after dicing, yields a time series, {Y0 (s0 ), Y1 (s0 ), . . .}. These are the main highways that traverse the cube but other, less-traveled paths, can be taken. In this paper, we discuss spatio-temporal data and processes whose domain is the space-time cube, and we incorporate them into hierarchical statistical models for spatio-temporal data.},
  language = {eng},
  usera = {filename=Cressie2020_measuring_mapping_uncertainty_quantification_space_time_cube.pdf},
  verbb = {issn-alternates=1988-2807},
}

