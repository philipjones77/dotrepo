  keywords = {Exact sciences and technology ; Gaussian field with generalized Cauchy covariance ; Gaussian field with generalized Cauchy covariance Gaussian sheet with generalized Cauchy covariance Self-similarity Long ; Gaussian sheet with generalized Cauchy covariance ; Inference from stochastic processes; time series analysis ; Lamperti transform ; Long/short range dependence ; Mathematics ; Physical Sciences ; Probability and statistics ; Probability theory and stochastic processes ; Science \textbackslash{}\& Technology ; Sciences and techniques of general use ; Self-similarity ; short range dependence Lamperti transform ; Statistics ; Statistics \textbackslash{}\& Probability ; Stochastic analysis ; Stochastic processes},
