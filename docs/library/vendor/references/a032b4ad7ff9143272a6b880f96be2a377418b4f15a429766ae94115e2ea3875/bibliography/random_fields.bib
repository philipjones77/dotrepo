@article{Bevilacqua2025,
  author = {Bevilacqua, Moreno and Caamaño-Carrillo, Christian and Faouzi, Tarik and Emery, Xavier},
  title = {Parsimonious Compactly Supported Covariance Models in the Gauss Hypergeometric Class: Identifiability, Reparameterizations, and Asymptotic Properties},
  journaltitle = {arXiv},
  date = {2025-06-16},
  doi = {10.48550/arXiv.2506.13646},
  url = {https://arxiv.org/abs/2506.13646},
  eprint = {2506.13646},
  eprinttype = {arxiv},
  eprintclass = {stat.ME},
  keywords = {Statistics - Methodology, stat.ME},
  abstract = {We study covariance functions in the Gauss hypergeometric ( GH ) class, a flexible family that encompasses the Generalized Wendland ( GW ) and Matérn ( MT ) models. We derive sharp validity conditions, providing a complete characterization of the admissible parameter space, and show that the model exhibits structural identifiability issues under both increasing- and fixed-domain asymptotics. To resolve this issue, we introduce a parsimonious compactly supported subclass selected via a maximum integral range criterion. The resulting hypergeometric model can be viewed as a structural refinement of theGWfamily and admits compact-support reparameterizations that recover theMTmodel as a limit case. We further establish strong consistency and asymptotic normality of the maximum likelihood estimator of the associated microergodic parameter under fixed-domain asymptotics. Simulation experiments and a real-data application to climate data illustrate the finite-sample behavior and practical performance of the proposed model.},
  language = {eng},
  usera = {filename=Bevilacqua2026_parsimonious_compactly_supported_covariance_models_gauss_hypergeometric_class.pdf},
  archiveprefix = {arXiv},
  copyright = {http://arxiv.org/licenses/nonexclusive-distrib/1.0},
}

