@article{Anderes2010,
  author = {Anderes, Ethan},
  title = {ON THE CONSISTENT SEPARATION OF SCALE AND VARIANCE FOR GAUSSIAN RANDOM FIELDS},
  journaltitle = {The Annals of statistics},
  volume = {38},
  number = {2},
  publisher = {Institute of Mathematical Statistics},
  location = {Cleveland, OH},
  date = {2010},
  pages = {870--893},
  doi = {10.1214/09-AOS725},
  url = {https://doi.org/10.1214/09-aos725},
  issn = {0090-5364},
  keywords = {60G60 ; 62M30 ; 62M40 ; Asymptotic methods ; Consistent estimators ; Covariance ; covariance estimation ; Exact sciences and technology ; Gaussian random fields ; General topics ; Histograms ; Inference from stochastic processes; time series analysis ; infill asymptotics ; Integers ; Linear inference, regression ; Mathematical functions ; Mathematical theorems ; Mathematics ; Matérn class ; Maximum likelihood estimation ; Maximum likelihood estimators ; Normal distribution ; principle irregular term ; Probability and statistics ; Probability theory and stochastic processes ; quadratic variations ; Sciences and techniques of general use ; Statistical variance ; Statistics ; Stochastic processes ; Studies ; Variances},
  abstract = {We present fixed domain asymptotic results that establish consistent estimates of the variance and scale parameters for a Gaussian random field with a geometric anisotropic Matérn autocovariance in dimension d > 4. When d 4, we show that one can estimate the coefficient on the principle irregular term accurately enough to get a consistent estimate of the coefficient on the second irregular term. These two coefficients can then be used to separate the scale and variance. We extend our results to the general problem of estimating a variance and geometric anisotropy for more general autocovariance functions. Our results illustrate the interaction between the accuracy of estimation, the smoothness of the random field, the dimension of the observation space and the number of increments used for estimation. As a corollary, our results establish the orthogonality of Matérn Gaussian random fields with different parameters when d > 4. The case d = 4 is still open.},
  language = {eng},
  usera = {filename=Anderes2010_consistent_separation_scale_variance_gaussian_random_fields.pdf},
  random_field_type = {continuous},
}

@article{Anderson2024,
  author = {Anderson, Sean C. and Ward, Eric J. and English, Philina A. and Barnett, Lewis A. K. and Thorson, James T.},
  title = {sdmTMB: An R Package for Fast, Flexible, and User-Friendly Generalized Linear Mixed Effects Models with Spatial and Spatiotemporal Random Fields},
  journaltitle = {bioRxiv},
  publisher = {Cold Spring Harbor Laboratory},
  date = {2024},
  doi = {10.1101/2022.03.24.485545},
  url = {https://www.biorxiv.org/content/early/2024/02/05/2022.03.24.485545},
  eprint = {https://www.biorxiv.org/content/early/2024/02/05/2022.03.24.485545.full.pdf},
  abstract = {Geostatistical spatial or spatiotemporal data are common across scientific fields. However, appropriate models to analyse these data, such as generalised linear mixed effects models (GLMMs) with Gaussian Markov random fields (GMRFs), are computationally intensive and challenging for many users to implement. Here, we introduce the R package sdmTMB, which extends the flexible interface familiar to users of lme4, glmmTMB, and mgcv to include spatial and spatiotemporal latent GMRFs using an SPDE-(stochastic partial differential equation) based approach. SPDE matrices are constructed with fmesher and estimation is conducted via maximum marginal likelihood with TMB or via Bayesian inference with tmbstan and rstan. We describe the model and explore case studies that illustrate sdmTMB\textbackslash{}textquoterights flexibility in implementing penalised smoothers, non-stationary processes (time-varying and spatially varying coefficients), hurdle models, cross-validation and anisotropy (directionally dependent spatial correlation). Finally, we compare the functionality, speed, and interfaces of related software, demonstrating that sdmTMB can be an order of magnitude faster than R-INLA. We hope sdmTMB\textbackslash{}textquoterights accessible interface will help open this useful class of models to a wider field of geostatistical analysts.Competing Interest StatementThe authors have declared no competing interest.},
  usera = {filename=Anderson2024_sdmtmb_package_fast_flexible_user_friendly_generalized_linear.pdf},
  userb = {software=Anderson2024_software},
  elocation-id = {2022.03.24.485545},
  random_field_type = {continuous},
}

