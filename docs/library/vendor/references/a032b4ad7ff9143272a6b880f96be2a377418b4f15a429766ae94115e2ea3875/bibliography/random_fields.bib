@report{Waghmare2023,
  author = {Waghmare, Kartik G. and Masak, Tomas and Panaretos, Victor M.},
  title = {The Functional Graphical Lasso},
  journaltitle = {arXiv},
  date = {2023-06-04},
  doi = {10.48550/arXiv.2306.02347},
  url = {https://arxiv.org/abs/2306.02347v2},
  eprint = {2306.02347v2},
  eprinttype = {arxiv},
  keywords = {stat.ME, math.ST},
  abstract = {We consider the problem of recovering conditional independence relationships between $p$ jointly distributed Hilbertian random elements given $n$ realizations thereof. We operate in the sparse high-dimensional regime, where $n \ll p$ and no element is related to more than $d \ll p$ other elements. In this context, we propose an infinite-dimensional generalization of the graphical lasso. We prove model selection consistency under natural assumptions and extend many classical results to infinite dimensions. In particular, we do not require finite truncation or additional structural restrictions. The plug-in nature of our method makes it applicable to any observational regime, whether sparse or dense, and indifferent to serial dependence. Importantly, our method can be understood as naturally arising from a coherent maximum likelihood philosophy.},
  usera = {filename=Waghmare2023_functional_graphical_lasso.pdf},
  userb = {supplemental=Waghmare2023_supplemental.pdf},
  random_field_type = {countable},
}

