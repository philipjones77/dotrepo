@article{Fuentes2002,
  author = {Fuentes, Montserrat},
  title = {Spectral methods for nonstationary spatial processes},
  journaltitle = {Biometrika},
  volume = {89},
  number = {1},
  date = {2002},
  pages = {197--210},
  doi = {10.1093/biomet/89.1.197},
  url = {https://doi.org/10.1093/biomet/89.1.197},
  eprint = {4140567},
  eprinttype = {jstor},
  issn = {0006-3444},
  keywords = {Spatial analysis ; Spatial statistics ; Spectral energy distribution ; Air pollution ; Anisotropy ; Applications ; Biology psychology social sciences ; Covariance ; Covariance matrices ; Density estimation ; Edge effect ; Environmental protection ; Estimators ; Exact sciences and technology ; Fourier transform ; Geostatistics ; Inference from stochastic processes; time series analysis ; Kernel smoothing ; Mathematics ; Nonparametric inference ; Parametric inference ; Periodogram ; Probability and statistics ; Sciences and techniques of general use ; Space based observatories ; Spatial models ; Stationary processes ; Statistical variance ; Statistics ; Variogram},
  abstract = {We propose a nonstationary periodogram and various parametric approaches for estimating the spectral density of a nonstationary spatial process. We also study the asymptotic properties of the proposed estimators via shrinking asymptotics, assuming the distance between neighbouring observations tends to zero as the size of the observation region grows without bound. With this type of asymptotic model we can uniquely determine the spectral density, avoiding the aliasing problem. We also present a new class of nonstationary processes, based on a convolution of local stationary processes. This model has the advantage that the model is simultaneously defined everywhere, unlike ‘moving window’ approaches, but it retains the attractive property that, locally in small regions, it behaves like a stationary spatial process. Applications include the spatial analysis and modelling of air pollution data provided by the US Environmental Protection Agency.},
  addendum = {JSTOR stable URL: http://www.jstor.org/stable/4140567. Published by Oxford University Press for the Biometrika Trust. Copyright 2002 Biometrika Trust.},
  language = {eng},
  usera = {filename=Fuentes2002_spectral_methods_nonstationary_spatial_processes.pdf},
  random_field_type = {continuous},
}

