  doi = {10.1023/A:1009703431535},
  url = {https://doi.org/10.1023/a:1009703431535},
  issn = {1572-3097},
  abstract = {A three-parameter stochastic process, termed the variance gamma process, is developed as a model for log stock-price dynamics. The process is obtained by evaluating Brownian motion with drift at a random time given by a gamma process, yielding additional parameters that control skewness and kurtosis. Closed forms are obtained for the return density and for European option prices. Statistical and risk-neutral densities are estimated for S\&P 500 data, and the resulting model is shown to correct pricing biases of the Black--Scholes model.},
  verbb = {issn-alternates=1573-692X},
}

