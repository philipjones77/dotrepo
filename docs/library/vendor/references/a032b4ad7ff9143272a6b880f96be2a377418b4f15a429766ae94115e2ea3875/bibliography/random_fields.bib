  url = {https://doi.org/10.1080/01621459.2018.1520114},
  issn = {0162-1459},
  keywords = {Bayesian analysis ; Computer simulation ; Density ; Distribution functions ; Gaussian mixtures ; Log-periodogram ; Markov chain Monte Carlo ; Mathematical models ; Modelling ; Multichannel electroencephalography ; Normal distribution ; Parameters ; Regression analysis ; Simulation ; Spectra ; Spectrum analysis ; Statistical methods ; Statistics ; Time series ; Whittle likelihood},
  abstract = {We develop a novel Bayesian modeling approach to spectral density estimation for multiple time series. Received October 2016 The log-periodogram distribution for each series is modeled as a mixture of Gaussian distributions with Revised August 2018 frequency-dependent weights and mean functions. The implied model for the log-spectral density is a mixture of linear mean functions with frequency-dependent weights. The mixture weights are built KEYWORDS through successive differences of a logit-normal distribution function with frequency-dependent param- Gaussian mixtures; Log-periodogram; Markov eters. Building from the construction for a single spectral density, we develop a hierarchical extension for chain Monte Carlo; multiple time series. Specifically, we set the mean functions to be common to all spectral densities and Multichannel make the weights specific to the time series through the parameters of the logit-normal distribution. In electroencephalography; addition to accommodating flexible spectral density shapes, a practically important feature of the proposed Whittle likelihood. formulation is that it allows for ready posterior simulation through a Gibbs sampler with closed form full conditional distributions for all model parameters. The modeling approach is illustrated with simulated datasets and used for spectral analysis of multichannel electroencephalographic recordings, which provides a key motivating application for the proposed methodology.},
  language = {eng},
  usera = {filename=Cadonna2019_bayesian_spectral_modeling_multiple_time_series.pdf},
}

