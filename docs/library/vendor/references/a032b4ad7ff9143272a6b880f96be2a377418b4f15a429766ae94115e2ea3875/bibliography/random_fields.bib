@article{Pereira2022,
  author = {Pereira, Mike and Desassis, Nicolas and Allard, Denis},
  title = {Geostatistics for Large Datasets on {Riemannian} Manifolds: A Matrix-Free Approach},
  journaltitle = {Journal of Data Science},
  volume = {20},
  number = {4},
  publisher = {School of Statistics, Renmin University of China},
  date = {2022},
  pages = {512--532},
  doi = {10.6339/22-JDS1075},
  url = {https://doi.org/10.6339/22-JDS1075},
  eprint = {2208.12501},
  eprinttype = {arxiv},
  eprintclass = {stat.ME},
  issn = {1683-8602},
  keywords = {Gaussian random fields, Riemannian manifolds, geostatistics, anisotropy, nonstationarity, finite elements, Laplace-Beltrami operator, SPDE, matrix-free methods, kriging},
  abstract = {Large or very large spatial (and spatio-temporal) datasets have become common place in many environmental and climate studies. These data are often collected in non-Euclidean spaces (such as the planet Earth) and they often present nonstationary anisotropies. This paper proposes a generic approach to model Gaussian Random Fields (GRFs) on compact Riemannian manifolds that bridges the gap between existing works on nonstationary GRFs and random fields on manifolds. This approach can be applied to any smooth compact manifolds, and in particular to any compact surface. By defining a Riemannian metric that accounts for the preferential directions of correlation, our approach yields an interpretation of the nonstationary geometric anisotropies as resulting from local deformations of the domain. We provide scalable algorithms for the estimation of the parameters and for optimal prediction by kriging and simulation able to tackle very large grids. Stationary and nonstationary illustrations are provided.},
  language = {english},
  usera = {filename=Pereira2022_geostatistics_large_datasets_riemannian_manifolds_matrix_free_approach.pdf},
  userb = {software=Pereira2022_software},
  copyright = {CC0 1.0 Universal},
}

@article{Pereira2026,
  author = {Pereira, Mike and Clarotto, Lucia and Desassis, Nicolas},
  title = {Prediction of spatio-temporal data on meshed surfaces using advection-diffusion SPDEs},
  journaltitle = {Spatial Statistics},
  volume = {74},
  eid = {101013},
  date = {2026-08},
  doi = {10.1016/j.spasta.2026.101013},
  url = {https://doi.org/10.1016/j.spasta.2026.101013},
  eprint = {2606.24300},
  eprinttype = {arxiv},
  keywords = {spatio-temporal statistics, stochastic partial differential equations, advection-diffusion, non-stationary Gaussian random fields, Riemannian manifolds, environmental statistics},
  abstract = {The aim of this work is to propose a statistical model for spatio-temporal data on meshed surfaces based on the Stochastic Partial Differential Equation (SPDE) modeling approach. Specifically, we focus on a class of advection-diffusion SPDEs defined on smooth compact orientable closed Riemannian manifolds of dimension 2, and their discretization via a Galerkin approach. We demonstrate how this method enables the development of scalable algorithms for the simulation and prediction of Gaussian random fields that are solutions to the discretized SPDE. Additionally, we present recent developments in the inference of such models. The method is applied to a simulated spatio-temporal dataset exhibiting advective and diffusive behavior on the sphere, as well as to a real case study on aerosol optical depth in the atmosphere across the globe’s surface.},
  language = {eng},
  usera = {filename=Pereira2025_prediction_spatio_temporal_data_meshed_surfaces_using_advection.pdf},
  userb = {software=Pereira2025_software},
  note = {Publication details corrected against the publisher on 7 September 2026. Former DOI 10.1038/s41598-025-00804-x identifies an unrelated earthquake article and was removed. Local PDF is the HAL manuscript hal-04132148v2 submitted 8 October 2025, not the published article; abstract retained from that preprint. Existing attachment filenames retain the historical key. Software folder retained; its attribution requires further evidence.},
  random_field_type = {continuous},
}

