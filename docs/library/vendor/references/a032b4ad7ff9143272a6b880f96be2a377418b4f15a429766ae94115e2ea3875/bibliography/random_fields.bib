@article{Louzada2021,
  author = {Louzada, Francisco and Do Nascimento, Diego Carvalho and Egbon, Osafu Augustine},
  title = {Spatial statistical models: An overview under the bayesian approach},
  journaltitle = {Axioms},
  volume = {10},
  number = {4},
  publisher = {Mdpi},
  location = {BASEL},
  date = {2021},
  pages = {307},
  doi = {10.3390/axioms10040307},
  url = {https://doi.org/10.3390/axioms10040307},
  issn = {2075-1680},
  keywords = {Bayesian analysis ; Bayesian inference ; Bayesian spatial models ; Big Data ; Data storage ; Epidemiology ; Fields (mathematics) ; Generalized linear models ; Internet of Things ; Machine learning ; Mathematics ; Mathematics, Applied ; Miniaturization ; Normal distribution ; Partial differential equations ; Physical Sciences ; Probability and statistical methods ; Random variables ; Science \textbackslash{}\& Technology ; Spatial smoothing ; Statistical analysis ; Statistical models ; Statistics ; Stochastic models ; Storage capacity ; Systematic review},
  abstract = {Spatial documentation is exponentially increasing given the availability of Big Data in the Internet of Things, enabled by device miniaturization and data storage capacity. Bayesian spatial statistics is a useful statistical tool to determine the dependence structure and hidden patterns in space through prior knowledge and data likelihood. However, this class of modeling is not yet well explored when compared to adopting classification and regression in machine-learning models, in which the assumption of the spatiotemporal independence of the data is often made, that is an inexistent or very weak dependence. Thus, this systematic review aims to address the main models presented in the literature over the past 20 years, identifying the gaps and research opportunities. Elements such as random fields, spatial domains, prior specification, the covariance function, and numerical approximations are discussed. This work explores the two subclasses of spatial smoothing: global and local.},
  language = {eng},
  usera = {filename=Louzada2021_spatial_statistical_models_overview_under_bayesian_approach.pdf},
}

@article{Louzada2025,
  author = {Louzada, Francisco and Ribeiro Diniz, Carlos Alberto and Dawodu, Oluwafunmilayo Adenike and Egbon, Osafu Augustine},
  title = {Bayesian spatio-temporal modelling: a systematic review},
  journaltitle = {Research in Statistics},
  volume = {3},
  number = {1},
  publisher = {Taylor \& Francis},
  date = {2025},
  doi = {10.1080/27684520.2025.2568891},
  url = {http://dx.doi.org/10.1080/27684520.2025.2568891},
  issn = {2768-4520},
  keywords = {spatio-temporal, Bayesian, Besag-York-Mollie, BYM, Gaussian Markov Random Field, GMRF, conditional auto-regressive, CAR, hierarchical modelling, systematic review},
  abstract = {Integrating time dimension into the spatial data poses additional challenges in implementing advanced statistical or computational methods for analyzing data. Applying spatio-temporal method in practical issues allows researchers to study the spatial patterns of a random phenomenon, such as disease or health-related issues, over time to give insights into an unusual pattern. Due to this, numerous techniques have been developed and adopted to model the underlying data, including Gaussian Markov Random Field (GMRF), conditional auto-regressive (CAR), Besag-York-Mollie (BYM), among others. Therefore, this study identifies methodological gaps in the literature by focusing on the development and content analysis of spatio-temporal modeling, that is, the geographical variation of space and time. It also aims to identify the areas of improvement in the spatio-temporal approach and develop an overview of the basic understanding of the concepts and advancements between 2003-2023. A graphical representation of the continents that best use or adopt the spatio-temporal model is displayed. In conclusion, the study identifies the directions and areas of opportunity for further studies.},
  note = {DOAJ landing page saved in inbox; Taylor and Francis PDF request returned HTTP error in this session.},
  language = {english},
  usera = {filename=Louzada2025_bayesian_spatio_temporal_modelling_systematic_review.pdf},
}

