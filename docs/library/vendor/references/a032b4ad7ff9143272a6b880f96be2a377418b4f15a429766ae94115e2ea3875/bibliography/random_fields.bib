@article{Lee2005,
  author = {Lee, Herbert K. H. and Higdon, Dave M. and Calder, Catherine A. and Holloman, Christopher H.},
  title = {Efficient models for correlated data via convolutions of intrinsic processes},
  journaltitle = {Statistical Modelling},
  volume = {5},
