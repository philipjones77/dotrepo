@article{Zeng2025,
  author = {Zeng, Zijian and Li, Meng and Vannucci, Marina},
  title = {Bayesian Covariate-Dependent Graph Learning with a Dual Group Spike-and-Slab Prior},
  journaltitle = {Biometrics},
  volume = {81},
  number = {2},
  date = {2025},
  pages = {ujaf053},
  doi = {10.1093/biomtc/ujaf053},
  url = {https://academic.oup.com/biometrics/article-abstract/81/2/ujaf053/8124915},
  urldate = {2026-03-20},
  issn = {0006-341X},
  abstract = {Covariate-dependent graph learning has gained increasing interest in the graphical modeling literature for the analysis of heterogeneous data. This task, however, poses challenges to modeling, computational efficiency, and interpretability. The parameter of interest can be naturally represented as a 3-dimensional array with elements that can be grouped according to 2 directions, corresponding to node level and covariate level, respectively. In this article, we propose a novel dual group spike-and-slab prior that enables multi-level selection at covariate-level and node-level, as well as individual (local) level sparsity. We introduce a nested strategy with specific choices to address distinct challenges posed by the various grouping directions. For posterior inference, we develop a full Gibbs sampler for all parameters, which mitigates the difficulties of parameter tuning often encountered in high-dimensional graphical models and facilitates routine implementation. Through simulation studies, we demonstrate that the proposed model outperforms existing methods in its accuracy of graph recovery. We show the practical utility of our model via an application to microbiome data where we seek to better understand the interactions among microbes as well as how these are affected by relevant covariates.},
  usera = {filename=Zeng2025_bayesian_covariate_dependent_graph_learning_with_dual_group.pdf},
  userb = {software=Zeng2025_appendix},
  userc = {supplemental=Zeng2025_supplemental},
  random_field_type = {countable},
  userd = {software=github/ZijianZeng/BCDR_DGSS},
  verbb = {issn-alternates=1541-0420},
}

@article{Zhang2002,
  author = {Zhang, Hao},
  title = {On Estimation and Prediction for Spatial Generalized Linear Mixed Models},
  journaltitle = {Biometrics},
  volume = {58},
  number = {1},
  publisher = {Blackwell Publishing Ltd},
  location = {Oxford, UK},
  date = {2002},
  pages = {129--136},
  doi = {10.1111/j.0006-341x.2002.00129.x},
  url = {https://doi.org/10.1111/j.0006-341x.2002.00129.x},
  issn = {0006-341X},
  keywords = {Algorithms ; Binomials ; Biometrics ; Computer Simulation ; data collection ; disease severity ; EM algorithm ; Epidemiology ; Generalized linear mixed models ; Hordeum - microbiology ; kriging ; Maximum likelihood estimation ; Maximum likelihood estimators ; Metropolis-Hastings algorithm ; Metropolitan areas ; Models, Statistical ; Monte Carlo Method ; Mycoses - epidemiology ; Mycoses - microbiology ; Non Gaussianity ; Plant Diseases - microbiology ; Plant roots ; Plant Roots - microbiology ; precision agriculture ; prediction ; Predictive Value of Tests ; root diseases ; Sample size ; Spatial interpolation ; Spatial models ; Variogram},
  abstract = {Summary. We use spatial generalized linear mixed models (GLMM) to model non‐Gaussian spatial variables that are observed at sampling locations in a continuous area. In many applications, prediction of random effects in a spatial GLMM is of great practical interest. We show that the minimum mean‐squared error (MMSE) prediction can be done in a linear fashion in spatial GLMMs analogous to linear kriging. We develop a Monte Carlo version of the EM gradient algorithm for maximum likelihood estimation of model parameters. A by‐product of this approach is that it also produces the MMSE estimates for the realized random effects at the sampled sites. This method is illustrated through a simulation study and is also applied to a real data set on plant root diseases to obtain a map of disease severity that can facilitate the practice of precision agriculture.},
  language = {eng},
}

@article{Zhang2004,
  author = {Zhang, Hao},
  title = {Inconsistent Estimation and Asymptotically Equal Interpolations in Model-Based Geostatistics},
  journaltitle = {Journal of the American Statistical Association},
