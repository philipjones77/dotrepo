}

@article{Sigrist2023,
  author = {Sigrist, Fabio},
  title = {Latent Gaussian Model Boosting},
  journaltitle = {IEEE Transactions on Pattern Analysis and Machine Intelligence},
  volume = {45},
  number = {2},
  date = {2023},
  pages = {1894--1905},
  doi = {10.1109/TPAMI.2022.3168152},
