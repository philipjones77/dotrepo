@article{Hernandez2026,
  author = {Hernández, Iván and Ibarra, Luis and Chairez, Isaac},
  title = {Scale Invariant Neural Networks Enhanced by a Covariance-Based Dynamic Filter},
  journaltitle = {IEEE Access},
  volume = {14},
  publisher = {Institute of Electrical and Electronics Engineers (IEEE)},
  date = {2026},
  pages = {26431--26444},
  doi = {10.1109/access.2026.3665421},
  url = {https://doi.org/10.1109/access.2026.3665421},
  issn = {2169-3536},
  abstract = {Neural networks frequently waste capacity on learning transformations (like scale changes in time series) that are irrelevant to the main classification or identification task. Current invariance approaches, whether architecture- or data-centric, remain computationally expensive, need careful tuning, and generalize poorly; moreover, none achieves online scale invariance without prior knowledge of the amplitude. To address this gap, it is here proposed a general time-series framework that imposes online scale invariance via an explicit, non-learned functional transformation: a covariance-based filter. This filter is first benchmarked against standard offline normalizers using real seismic signals, demonstrating preservation of waveform shape and frequency content (Fréchet distance 1.9 × 10−4 ; spectral correlation > 0.99). The invariant filter is then used as the initial layer of a Long Short-Term Memory (LSTM) network for frequency estimation. A comparative evaluation with amplitude-varying sinusoidal signals, using the Sum of Squared Errors (SSEs) as the metric, shows notable gains: a conventional 10-unit LSTM with data augmentation needed 50, 000 training epochs to reach an SSE of 686 rad2 /s2 , while the invariant LSTM achieved the same error with only 4 units in 30, 766 epochs. The contributions of this work are threefold: theoretical, by proposing a deterministic, non-learned invariant function; methodological, by designing a generalizable preprocessing filter; and applied, by showing faster convergence and lower model complexity for LSTM-based time-series analysis.},
  usera = {filename=Hernandez2026_scale_invariant_neural_networks_enhanced_covariance_based_dynamic.pdf},
}

@article{Higashiguchi2026,
  author = {Higashiguchi, Shingo and Kawabata, Koki and Matsubara, Yasuko and Sakurai, Yasushi},
  title = {Interpretable Dynamic Network Modeling of Tensor Time Series via {Kronecker} Time-Varying Graphical Lasso},
  journaltitle = {arXiv},
  publisher = {Cornell University Library, arXiv.org},
  location = {Ithaca},
  date = {2026},
  doi = {10.48550/arXiv.2602.08197},
  url = {https://arxiv.org/abs/2602.08197},
  eprint = {2602.08197},
  eprinttype = {arxiv},
  eprintclass = {cs.LG},
  issn = {2331-8422},
  keywords = {Time series, Tensors, dynamic network estimation, Kronecker product, graphical lasso, time-varying graphical models, KTVGL, stat.ML, cs.LG},
  abstract = {With the rapid development of web services, large amounts of time series data are generated and accumulated across various domains such as finance, healthcare, and online platforms. As such data often co-evolves with multiple variables interacting with each other, estimating the time-varying dependencies between variables (i.e., the dynamic network structure) has become crucial for accurate modeling. However, real-world data is often represented as tensor time series with multiple modes, resulting in large, entangled networks that are hard to interpret and computationally intensive to estimate. In this paper, we propose Kronecker Time-Varying Graphical Lasso (KTVGL), a method designed for modeling tensor time series. Our approach estimates mode-specific dynamic networks in a Kronecker product form, thereby avoiding overly complex entangled structures and producing interpretable modeling results. Moreover, the partitioned network structure prevents the exponential growth of computational time with data dimension. In addition, our method can be extended to stream algorithms, making the computational time independent of the sequence length. Experiments on synthetic data show that the proposed method achieves higher edge estimation accuracy than existing methods while requiring less computation time. To further demonstrate its practical value, we also present a case study using real-world data. Our source code and datasets are available at https://github.com/Higashiguchi-Shingo/KTVGL.},
  note = {Companion repository: \url{https://github.com/Higashiguchi-Shingo/KTVGL}},
  language = {english},
  usera = {filename=Higashiguchi2026_interpretable_dynamic_network_modeling_tensor_time_series_kronecker.pdf},
  userb = {software=Higashiguchi2026_software},
  copyright = {http://creativecommons.org/licenses/by/4.0/},
}

