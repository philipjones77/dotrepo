@article{Mohammadi2015,
  author = {Mohammadi, Reza and Wit, Ernst C.},
  title = {BDgraph: An R Package for Bayesian Structure Learning in Graphical Models},
  journaltitle = {Journal of Statistical Software},
  volume = {89},
  number = {3},
  date = {2015-01-21},
  pages = {1--30},
  doi = {10.18637/jss.v089.i03},
