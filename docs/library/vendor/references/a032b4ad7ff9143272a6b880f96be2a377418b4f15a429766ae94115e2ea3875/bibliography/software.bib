@online{AlSahili2023,
  author = {Al Sahili, Zahraa and Awad, Mariette},
  title = {Spatio-Temporal Graph Neural Networks: A Survey},
  journaltitle = {arXiv},
  date = {2023},
  doi = {10.48550/arXiv.2301.10569},
  url = {https://arxiv.org/abs/2301.10569v2},
  eprint = {2301.10569},
  eprinttype = {arxiv},
  keywords = {graph neural networks, spatio-temporal graphs, time series, survey},
  note = {Preprint version 2, dated 11 February 2023.},
  usera = {filename=AlSahili2023_spatio_temporal_graph_neural_networks_survey.pdf},
  abstract = {Graph Neural Networks have gained huge interest in the past few years. These powerful algorithms expanded deep learning models to non-Euclidean space and were able to achieve state of art performance in various applications including recommender systems and social networks. However, this performance is based on static graph structures assumption which limits the Graph Neural Networks' performance when the data varies with time. Spatio-temporal Graph Neural Networks are extension of Graph Neural Networks that takes the time factor into account. Recently, various Spatio-temporal Graph Neural Network algorithms were proposed and achieved superior performance compared to other deep learning algorithms in several time dependent applications. This survey discusses interesting topics related to Spatio-temporal Graph Neural Networks, including algorithms, applications, and open challenges.},
}

