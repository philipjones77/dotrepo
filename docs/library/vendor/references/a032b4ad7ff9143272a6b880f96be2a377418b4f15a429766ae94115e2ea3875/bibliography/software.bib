  issn = {1524-0703},
  keywords = {Laplace-Beltrami operator, point clouds, persistent homology, topology, spectral analysis},
  abstract = {This paper proposes a topology-controlled method for computing the Laplace--Beltrami operator on point clouds. Starting from a k-nearest-neighbor graph, the method uses local tangent-plane estimates, a Vietoris--Rips complex, and persistent homology to identify and remove spurious edges, yielding a neighborhood graph that better preserves manifold topology and improves spectral analysis.},
