@article{Pruher2021,
  author = {Pruher, Jakub and Karvonen, Toni and Oates, Chris J. and Straka, Ondrej and S{\"a}rkk{\"a}, Simo},
  title = {Improved Calibration of Numerical Integration Error in Sigma-Point Filters},
  journaltitle = {IEEE Transactions on Automatic Control},
  volume = {66},
  number = {3},
  publisher = {IEEE},
  location = {New York},
  date = {2021},
  pages = {1286--1292},
  doi = {10.1109/TAC.2020.3009928},
  url = {https://doi.org/10.1109/TAC.2020.3009928},
  issn = {0018-9286},
  keywords = {Bayes methods, Bayesian quadrature (BQ), Errors, Extended Kalman filter, Gaussian processes (GPs), Kalman filters, Numerical integration, quantification of uncertainty, sigma points, Uncertainty, Numerical integration ; sigma points ; Bayes methods ; Bayesian quadrature (BQ) ; Context ; Errors ; Extended Kalman filter ; Gaussian processes (GPs) ; Kalman filters ; Mathematical analysis ; Polynomials ; Probabilistic logic ; Probabilistic models ; Quadratures ; quantification of uncertainty ; Stochastic processes ; Transforms ; Uncertainty},
  abstract = {The sigma-point filters, such as the unscented Kalman filter, are popular alternatives to the ubiquitous extended Kalman filter. The classical quadrature rules used in the sigma-point filters are motivated via polynomial approximation of the integrand; however, in the applied context, these assumptions cannot always be justified. As a result, a quadrature error can introduce bias into estimated moments, for which there is no compensatory mechanism in the classical sigma-point filters. This can lead in turn to estimates and predictions that are poorly calibrated. In this article, we investigate the Bayes-Sard quadrature method in the context of sigma-point filters, which enables uncertainty due to quadrature error to be formalized within a probabilistic model. Our first contribution is to derive the well-known classical quadratures as special cases of the Bayes-Sard quadrature method. Based on this, a general-purpose moment transform is developed and utilized in the design of a novel sigma-point filter, which explicitly accounts for the additional uncertainty due to quadrature error.},
  language = {eng},
  usera = {filename=Pruher2021_improved_calibration_numerical_integration_error_sigma_point_filters.pdf},
  copyright = {Copyright The Institute of Electrical and Electronics Engineers, Inc. (IEEE) 2021},
}

