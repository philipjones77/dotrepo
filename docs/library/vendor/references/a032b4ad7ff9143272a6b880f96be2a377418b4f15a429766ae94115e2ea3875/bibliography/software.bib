  eprinttype = {arxiv},
  eprintclass = {cs.MS},
  keywords = {Mathematical Software, scientific machine learning, JAX, PETSc, differentiable simulation, finite element methods, high-performance computing},
  abstract = {The rapid rise of scientific machine learning has expanded the role of differentiable modeling, surrogate modeling, and data-driven constitutive laws in large-scale simulation. JAX provides automatic differentiation, vectorization and GPU acceleration, but large-scale simulation still relies on mature HPC infrastructure such as PETSc for scalable MPI-based parallelism, robust solvers and preconditioning. JetSCI is a hybrid JAX-PETSc framework that uses JAX for GPU-parallel differentiable discretizations and PETSc for robust, scalable solution of the resulting systems on distributed-memory architectures, exposing multilevel parallelism through GPU acceleration within nodes and MPI parallelism across nodes. For finite element discretizations of heterogeneous micromechanics problems, JetSCI outperforms JAX-only implementations in efficiency and accuracy.},
  note = {No public JetSCI source repository was found during verification on 2026-08-22.},
