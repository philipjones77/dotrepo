@software{Trailovic2025,
  author = {Trailović, Katarina},
  title = {Mathematica Code for “Evaluation of Lefschetz Thimble Intersection Numbers via Multiple Shooting Method”},
  journaltitle = {Journal of High Energy Physics},
  volume = {2025},
  number = {5},
  date = {2025-10},
  doi = {10.1007/jhep05(2025)142},
  url = {https://github.com/KTrailovic/Lefschetz_Thimble_Intersection_Numbers},
  urldate = {2026-03-21},
  issn = {1029-8479},
  abstract = {A bstract Quantum cosmology aims at elucidating the beginning of our Universe. Back in early 80’s, Vilenkin and Hartle-Hawking put forward the “tunneling from nothing” and “no boundary” proposals. Recently there has been renewed interest in this subject from the viewpoint of defining the oscillating path integral for Lorentzian quantum gravity using the Picard-Lefschetz theory. Aiming at going beyond the mini-superspace and saddle-point approximations, we perform Monte Carlo calculations using the generalized Lefschetz thimble method to overcome the sign problem. In particular, we confirm that either the Vilenkin or the Hartle-Hawking saddle point becomes relevant if one uses the Robin boundary condition depending on its parameter. We also clarify some fundamental issues in quantum cosmology, such as an issue related to the integration domain of the lapse function.},
  note = {Mathematica notebook with multiple-shooting solver and upward-flow visualization examples},
  usera = {software=github/KTrailovic/Lefschetz_Thimble_Intersection_Numbers},
}

