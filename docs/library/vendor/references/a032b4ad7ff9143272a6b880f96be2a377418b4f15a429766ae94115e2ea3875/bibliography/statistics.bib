@article{Vehtari2017,
  author = {Vehtari, Aki and Gelman, Andrew and Gabry, Jonah},
  title = {Practical {Bayesian} Model Evaluation Using Leave-One-Out Cross-Validation and {WAIC}},
  journaltitle = {Statistics and Computing},
  volume = {27},
