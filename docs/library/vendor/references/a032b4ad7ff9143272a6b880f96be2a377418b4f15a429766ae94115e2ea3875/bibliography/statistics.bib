@article{Marin2026,
  author = {Marin, Santiago and Loong, Bronwyn and Westveld, Anton H.},
  title = {Adaptive Shrinkage with a Nonparametric Bayesian Lasso},
  journaltitle = {Journal of Computational and Graphical Statistics},
