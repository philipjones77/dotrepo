\GlsXtrRecordCounter{chapter}
%https://tex.stackexchange.com/questions/89107/glossary-per-chapter-or-section
\newcommand{\printchapterglossary}[1][]{%
  \printunsrtglossary*[nonumberlist,#1]{%
    \renewcommand{\printunsrtglossaryhandler}[1]{%
    \glsxtrfieldxifinlist{##1}{record.chapter}{\thechapter}
    {\glsxtrunsrtdo{##1}}%
    {}%
   }%
   \ifcsundef{theHchapter}%
   {%
     \setkeys{printgloss}{targetnameprefix={record.\csuse{thechapter}.}}%
   }%
   {%
     \setkeys{printgloss}{targetnameprefix={record.\csuse{theHchapter}.}}%
   }%
  }%
}

\renewcommand*{\glsclearpage}{}


% Customize glossary style to cite on first use for c-code category
\glsdefpostlink{c-code}{%
    \glsxtrifwasfirstuse{% true case
        \glsxtrifhasfield{useri}{\glslabel}{\space%
        % \glscurrentfieldvalue needs to be expanded
        % before being passed to \cite.
            (\expandafter\cite\expandafter{\glscurrentfieldvalue})}%
        {}% false glsxtrifhasfield
    }% end true glsxtrifwasfirstuse
    {}%{<false>} glsxtrifwasfirstuse
} % end glsdefpostlink

% Customize glossary display style to include citation if present
\glsdefpostdesc{c-code}{%
    \glsxtrifhasfield{useri}{\glscurrententrylabel}{\space%
    % \glscurrentfieldvalue needs to be expanded
    % before being passed to \cite.
        (See \expandafter\textcite\expandafter{\glscurrentfieldvalue})}%
    {}% false glsxtrifhasfield
    \glsxtrifhasfield{userii}{\glscurrententrylabel}{\space%
    % \glscurrentfieldvalue needs to be expanded
    % before being passed to \cite.
        (See \expandafter\url\expandafter{\glscurrentfieldvalue})}%
    {}% false glsxtrifhasfield
}% end glsdefpostdesc










