[include]
    path = ~/.dotrepo/git/gitconfig.shared
[user]
    name = Philip Jones
    email = 54629456+philipjones77@users.noreply.github.com
[core]
    editor = code --wait
    autocrlf = true
[diff]
    tool = vscode
[merge]
    tool = vscode
[difftool "vscode"]
    cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"
[mergetool "vscode"]
    cmd = code --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"
    keepBackup = false
[include]
    path = ~/.gitconfig.local
