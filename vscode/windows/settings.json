{
  "workbench.editorAssociations": {
    "*.pdf": "dotrepo.sumatraPdf",
    "*.png": "imagePreview.previewEditor",
    "*.jpg": "imagePreview.previewEditor",
    "*.jpe": "imagePreview.previewEditor",
    "*.jpeg": "imagePreview.previewEditor",
    "*.bmp": "imagePreview.previewEditor",
    "*.gif": "imagePreview.previewEditor",
    "*.ico": "imagePreview.previewEditor",
    "*.webp": "imagePreview.previewEditor",
    "*.avif": "imagePreview.previewEditor",
    "*.svg": "imagePreview.previewEditor",
    "*.md": "vscode.markdown.preview.editor"
  },
  "workbench.diffEditorAssociations": {
    "*.md": "default"
  },
  "workbench.colorCustomizations": {},
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "lldb.suppressUpdateNotifications": true,
  "explorer.confirmDelete": false,
  "python.defaultInterpreterPath": "${env:USERPROFILE}/.virtualenvs/py313/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "path": "pwsh.exe",
      "args": [
        "-NoLogo"
      ]
    }
  },
  "terminal.integrated.automationProfile.windows": {
    "path": "pwsh.exe",
    "args": [
      "-NoLogo"
    ]
  },
  "terminal.integrated.rightClickBehavior": "copyPaste",
  "terminal.integrated.sendKeybindingsToShell": false,
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.terminal.paste"
  ],
  "python.analysis.indexing": false,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": [
    "**/.git",
    "**/.venv",
    "**/node_modules",
    "**/__pycache__",
    "**/build",
    "**/dist",
    "**/outputs",
    "**/results",
    "**/benchmarks/out*",
    "**/.pytest_cache",
    "**/.mypy_cache"
  ]
}
