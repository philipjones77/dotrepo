{
  "workbench.editorAssociations": {
    "*.pdf": "dotrepo.sumatraPdf",
    "*.png": "imagePreview.previewEditor",
    "*.jpg": "imagePreview.previewEditor",
    "*.jpe": "imagePreview.previewEditor",
    "*.jpeg": "imagePreview.previewEditor",
    "*.bmp": "imagePreview.previewEditor",
    "*.gif": "imagePreview.previewEditor",
    "*.ico": "imagePreview.previewEditor",
    "*.webp": "imagePreview.previewEditor",
    "*.avif": "imagePreview.previewEditor",
    "*.svg": "imagePreview.previewEditor",
    "*.md": "vscode.markdown.preview.editor"
  },
  "workbench.diffEditorAssociations": {
    "*.md": "default"
  },
  "security.allowedUNCHosts": [
    "wsl.localhost"
  ],
  "python.defaultInterpreterPath": "${env:HOME}/.virtualenvs/py313/bin/python",
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.rightClickBehavior": "copyPaste",
  "terminal.integrated.sendKeybindingsToShell": false,
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.terminal.paste"
  ],
  "terminal.integrated.cwd": "${env:HOME}",
  "python.analysis.indexing": false,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": [
    "**/.git",
    "**/.venv",
    "**/node_modules",
    "**/__pycache__",
    "**/build",
    "**/dist",
    "**/outputs",
    "**/results",
    "**/benchmarks/out*",
    "**/.pytest_cache",
    "**/.mypy_cache"
  ]
}
